+def _material_sides(plan, paras, flow) -> list:
+    """段落ごとに、本文の流れでない段落（図・表のキャプションなど）の、図・表の中身（画像だけの段落・表のセル）が docx のどちらの側に
+    あるか: "before"（キャプションのすぐ前。キャプションが図・表の下）・"after"（すぐ後ろ。キャプションが図・表の上）・"both"（両方、
+    どちらでもない、図形の中のキャプションなど。決められない）。キャプションでない段落（表のセルなど）は ""、本文の流れの段落は None。PDF でも、図・表の中の文字はキャプションの
+    その側に出る（_EdgeAudit）。"""
+    from .linker import body_paragraphs
+    where = {p.src: w for p, w in body_paragraphs(plan)}
+    allp = [p for p in plan.paras.values() if not p.is_blank]
+    at = {p.src: k for k, p in enumerate(allp)}
+
+    def material(p):
+        return where.get(p.src) == "cell" or (bool(p.images) and not p.text_only().strip())
+    out = []
+    for (p, _, _), f in zip(paras, flow):
+        k = at.get(p.src)
+        if f:
+            out.append(None)
+        elif where.get(p.src) != "caption":
+            out.append("")            # 表のセル・図形の中の段落など（キャプションでない）
+        elif p.float_id or p.in_textbox or k is None:
+            out.append("both")
+        else:
+            before = k > 0 and material(allp[k - 1])
+            after = k + 1 < len(allp) and material(allp[k + 1])
+            out.append("before" if before and not after else "after" if after and not before else "both")
+    return out
