+def _solid(seg, st: PdfStream, width, doubt=()) -> bool:
+    """一致した文字の部分 seg（(seq の位置, 列の位置) のリスト）に、本文の行（段落の行の幅 width の FULL_LINE 以上の行で、行の
+    文字の半分以上が seg の文字）があるか（図の中の文字に挟まれた行〈doubt〉が 1 つでもあれば、ないとみなす）。"""
+    if not width:
+        return False
+    cnt = Counter(st.line[k] for _, k in seg)
+    if any(ln in doubt for ln in cnt):
+        return False
+    for ln, n in cnt.items():
+        ks = range(bisect.bisect_left(st.line, ln), bisect.bisect_right(st.line, ln))
+        size = sum(1 for k in ks if not st.soft[k] and st.date[k] < 0)
+        if 2 * n >= size and _line_width(st.lines[ln]) >= FULL_LINE * width:
+            return True
+    return False
+
