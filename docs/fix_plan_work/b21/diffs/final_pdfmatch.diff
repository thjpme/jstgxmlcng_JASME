+def _figure_line(st: PdfStream, ln, owner, nonflow, width) -> bool:
+    """PDF の行 ln が、段落の本文の行でなく、図・表の中の行かもしれないか（_isolate。その行の一致は、前後の行と本文の行の流れで
+    続けない）。段落の行は両端そろえで行の幅いっぱいになり、段落の最後の行は文の終わりで終わるので、行の幅 width の FULL_LINE
+    より短く、文の終わりで終わらない行は本文の行らしくない（図の中の語句「時間を見る」が、段落の続きの docx の文字「時間を
+    取った。」と最初の数文字が同じだと、照合はその行を段落の行と並べる）。そのような行で、すぐ前かすぐ後ろの行（_line_kind が
+    "skip" の行は 5 行まで飛ばす）が、図・表のキャプションなどの行か、どの段落にも当たらない和文の行のもの。和文の文字が半分に
+    満たない行（英文など）は見ない。行の幅は、受付日の文字を除いて測る。"""
+    if not width:
+        return False
+    ks = range(bisect.bisect_left(st.line, ln), bisect.bisect_right(st.line, ln))
+    body = "".join(st.chars[k] for k in ks if st.date[k] < 0 and not st.soft[k])
+    if not body or sum(1 for c in body if unicodedata.east_asian_width(c) in "FWA") * 2 < len(body):
+        return False
+    w = _line_width(st.lines[ln]) - _line_width("".join(st.chars[k] for k in ks if st.date[k] >= 0))
+    if w >= FULL_LINE * width or _ends_sentence(body):
+        return False
+    for step in (-1, 1):
+        x = ln + step
+        for _ in range(6):
+            if not 0 <= x < len(st.lines):
+                break
+            kind = _line_kind(st, x, owner, nonflow)
+            if kind == "figure":
+                return True
+            if kind == "text":
+                break
+            x += step
+    return False
