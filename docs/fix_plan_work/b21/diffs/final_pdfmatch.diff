+def _flow_breaks(src, ka, kb, st: PdfStream, owner, width, figure=None) -> bool:
+    """段落 src の、PDF の列の位置 ka の文字（照合で一致した文字）から kb の文字（次に一致した文字）へ、本文の行の流れが続かないか。
