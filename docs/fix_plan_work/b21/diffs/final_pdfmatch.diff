+def _line_owners(st: PdfStream, ln, owner) -> set:
+    """PDF の行 ln の文字（受付日・行末のハイフンを除く）が当たった段落 ID の集合。"""
+    ks = range(bisect.bisect_left(st.line, ln), bisect.bisect_right(st.line, ln))
+    return {owner[k] for k in ks if k in owner and not st.soft[k] and st.date[k] < 0}
+
+
+def _typeset_line(st: PdfStream, ln, owner) -> bool:
+    """PDF の行 ln が、組版の文字だけの行（文字のない行・受付日の文字だけの行・ページの最初の端の柱の候補の行で、どの段落にも
+    当たらないもの）か。ページの最後の端の行は柱の位置でないので、組版の文字とみなさない（図・表の中の文字やキャプション、
+    本当の段落の最後の行かもしれない）。"""
+    ks = [k for k in range(bisect.bisect_left(st.line, ln), bisect.bisect_right(st.line, ln)) if not st.soft[k]]
+    return all(st.date[k] >= 0 or (st.top[k] and st.head[k] and k not in owner) for k in ks)
+
