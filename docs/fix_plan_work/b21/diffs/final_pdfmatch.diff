+def _line_kind(st: PdfStream, ln, owner, nonflow) -> str:
+    """_figure_line で見る、PDF の行 ln の種類。"figure": 本文の流れでない段落（図・表のキャプション・表のセルなど）の文字のある
+    行か、どの段落にも当たらない和文の行（図・表の中の文字）。"text": どれかの本文の流れの段落の文字のある行。"skip": 受付日の
+    文字だけの行・ページの端の柱の候補の行・MIN_CHARS 文字未満の行・和文の文字のない行（数式・数字だけの行など）。"""
+    ks = range(bisect.bisect_left(st.line, ln), bisect.bisect_right(st.line, ln))
+    body = [k for k in ks if not st.soft[k] and st.date[k] < 0]
+    if not body:
+        return "skip"
+    owners = {owner.get(k) for k in body} - {None}
+    if owners & nonflow:
+        return "figure"
+    if owners:
+        return "text"
+    if (st.edge[body[0]] and st.head[body[0]]) or _visible_count(st.lines[ln]) < MIN_CHARS or \
+            not any(unicodedata.east_asian_width(st.chars[k]) in "FW" for k in body):
+        return "skip"
+    return "figure"
+
+
+def _edge_alternative(st: PdfStream, ln, step, owner, nonflow, src, width) -> bool:
+    """段落 src の本体の最後（step = 1。-1 なら最初）の行 ln のすぐ後ろ（前）が、図・表のキャプションなど（本文の流れでない
+    段落の文字の行。間の、_line_kind が "skip" の行は飛ばす）で、その向こうの、次（前）の本文の段落の行より手前に、段落の最後
+    （最初）の行らしい、どの段落にも当たらない和文の行（最後なら文の終わりで終わる行、最初なら段落の行の幅いっぱいの行。
+    受付日の文字だけの行・ページの端の柱の候補の行・MIN_CHARS 文字未満の行を除く）があるか（_isolate）。"""
+    if not width:
+        return False
+    x, sep = ln + step, False
+    for _ in range(80):
+        if not 0 <= x < len(st.lines):
+            return False
+        ks = range(bisect.bisect_left(st.line, x), bisect.bisect_right(st.line, x))
+        body = [k for k in ks if not st.soft[k] and st.date[k] < 0]
+        owners = {owner.get(k) for k in body} - {None}
+        if owners & nonflow:
+            sep = True
+        elif owners - {src}:
+            return False                 # 次（前）の本文の段落の行
+        elif not sep:
+            if owners or _line_kind(st, x, owner, nonflow) != "skip":
+                return False             # 本体の端の行のすぐ向こうが、キャプションなどでない
+        elif body and not owners and not (st.edge[body[0]] and st.head[body[0]]) and \
+                _visible_count(st.lines[x]) >= MIN_CHARS:
+            s = "".join(st.chars[k] for k in body)
+            if sum(1 for c in s if unicodedata.east_asian_width(c) in "FWA") * 2 >= len(s) and (
+                    _ends_sentence(s) if step > 0 else _line_width(st.lines[x]) >= FULL_LINE * width):
+                return True
+        x += step
+    return False
+
